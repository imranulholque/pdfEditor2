{
 "name": "pdf-editor",
 "version": "1.1.0",
 "description": "Simple PDF Editor",
 "author": "PDF Editor",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "build": "electron-builder --win --publish never",
  "test": "node test/bn.test.js && node test/geom.test.js && node test/pdfops.test.js && node test/text.test.js"
 },
 "dependencies": {
  "pdfjs-dist": "3.11.174",
  "pdf-lib": "1.17.1",
  "@pdf-lib/fontkit": "1.1.1"
 },
 "devDependencies": {
  "electron": "^31.0.0",
  "electron-builder": "^24.13.3"
 },
 "build": {
  "appId": "com.local.pdfeditor",
  "productName": "PDF Editor",
  "fileAssociations": [
   {
    "ext": "pdf",
    "name": "PDF Document",
    "role": "Editor"
   }
  ],
  "win": {
   "target": "nsis"
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true,
   "perMachine": false
  },
  "npmRebuild": false
 }
}